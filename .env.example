# Configuration for the PO update pipeline. Copy to `.env` and fill in.
#
# THIS FILE IS THE COMPLETE CONTRACT. Every environment variable the project
# reads is listed here, including the two that deliberately live somewhere else
# (see the last section) -- because an example file that documents most of them
# reads as exhaustive and quietly isn't.
#
# `.env` is gitignored -- but note this folder is OneDrive-synced, so `.env`
# WILL sync to the cloud. It holds identifiers and paths, never key material,
# which is why that is tolerable; every private key lives OUTSIDE OneDrive. Keep
# it that way.
#
# Values below are either empty (you supply them) or a non-secret default worth
# keeping visible. Nothing tenant-specific or credential-shaped is prefilled.

# ---------------------------------------------------------------------------
# NetSuite M2M (OAuth 2.0 Client Credentials) -- see NETSUITE-M2M-SETUP.md
# ---------------------------------------------------------------------------

# Sandbox account id, e.g. 1321665-sb2. Sandbox-first is a firm project rule:
# test_phase1_writeback.py refuses to write to a non-sandbox account unless
# explicitly overridden.
NS_ACCOUNT_ID=1321665-sb2

# The Integration record's CONSUMER KEY / CLIENT ID (Step 3 of the setup doc).
# Shown exactly once at creation -- if you lost it, regenerate on the record.
# This is NOT the consumer secret; client credentials flow doesn't use a secret.
NS_CLIENT_ID=

# The Certificate ID from Setup > Integration > OAuth 2.0 Client Credentials
# (M2M) Setup (Step 4). Becomes the JWT `kid` header.
NS_CERTIFICATE_ID=

# Path to the PRIVATE key from generate_m2m_keypair.py -- never the certificate.
NS_PRIVATE_KEY_PATH=%USERPROFILE%\.po-agent\keys\netsuite_m2m_private.pem

# PS256 (default) or RS256. Both are accepted by NetSuite for RSA keys; if the
# token endpoint returns invalid_request, try the other one.
NS_JWT_ALGORITHM=PS256

# Only if you generated the key with --passphrase.
# NS_PRIVATE_KEY_PASSPHRASE=

# NS_HTTP_TIMEOUT=60

# ---------------------------------------------------------------------------
# Microsoft Graph (Outlook intake) -- see config.GraphConfig.from_env
# ---------------------------------------------------------------------------

# Which client to build: "mock" or "real". NOTHING ELSE, and there is no
# default -- an empty or misspelled value raises rather than guessing, and it
# can never fall back to "real". While this is "mock" the three identifiers
# below are NOT required, so development is not blocked waiting on IT.
GRAPH_CLIENT=mock

# Entra tenant (directory) id, application (client) id, and the mailbox to
# poll. Required ONLY when GRAPH_CLIENT=real, and then validated at load time
# rather than at first use, so a misconfiguration fails before any network call.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_MAILBOX=

# The PRIVATE KEY used to sign the client assertion. Forward slashes -- most
# .env readers eat backslashes as escapes. Must live outside this OneDrive
# folder.
GRAPH_CERT_PATH=

# The PUBLIC CERTIFICATE matching GRAPH_CERT_PATH. Two variables rather than
# one because a private key carries no thumbprint: SHA-1 is computed over the
# certificate. The loader needs both to verify they are genuinely a pair, which
# is what catches "the cert uploaded to Entra is not the one this key belongs
# to" -- a thumbprint match alone only proves you typed the fingerprint
# correctly. Named explicitly rather than derived from the .key filename: a
# check that silently disappears when a file is renamed is worse than one that
# was never there.
GRAPH_CERT_PUBLIC_PATH=

# SHA-1 thumbprint of that certificate, 40 hex characters, as shown in the
# Entra app registration. Colons and lowercase are accepted and normalised.
# NOT the Entra "Certificate ID" / keyId GUID -- that identifies the credential
# entry in the portal and is not an auth input; record it in the setup doc.
GRAPH_CERT_THUMBPRINT=

# ---------------------------------------------------------------------------
# Read by the project but NOT loaded from this file
# ---------------------------------------------------------------------------
# Listed so this file stays the complete contract, with the reason each one
# lives elsewhere.

# ANTHROPIC_API_KEY -- the extractor's credential. Loaded from
# %USERPROFILE%\.po-agent\.env, deliberately OUTSIDE this OneDrive-synced
# folder, because unlike everything above it is real key material. Do not put
# it in `.env`. See claude_extractor.SECRETS_ENV_PATH.

# PO_AGENT_DB_URL -- optional override for the Alembic target database, read
# from the process environment by migrations/env.py. Unset means the URL in
# alembic.ini.
